                                  {
                                      "name":  "TC01 - Register (bo qua neu da ton tai)",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "const res = pm.response.json();",
                                                                                    "const s = pm.response.code;",
                                                                                    "if (s === 201) { pm.collectionVariables.set(\u0027token\u0027, res.data.accessToken); console.log(\u0027Registered OK - token saved\u0027); }",
                                                                                    "else if (s === 409 || s === 400) { console.log(\u0027User exists - chay TC02 de login\u0027); }",
                                                                                    "else { console.log(\u0027Unexpected:\u0027, s, JSON.stringify(res)); }"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\"email\": \"{{testEmail}}\", \"password\": \"{{testPassword}}\", \"fullName\": \"Apple IAP Tester\", \"phone\": \"0912345678\", \"preferredLanguage\": \"vi\"}"
                                                               },
